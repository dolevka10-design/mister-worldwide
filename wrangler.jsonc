{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mister-worldwide",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
